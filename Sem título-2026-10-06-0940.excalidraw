      "type": "text",
      "x": 1481.6989359846496,
      "y": 999.1892551892547,
      "width": 1025.9515088086516,
      "height": 674.9947671376244,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
